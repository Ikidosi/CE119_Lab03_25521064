.data
n_val:  .word 20
msg1:   .asciiz "F("
msg2:   .asciiz ") = "

.text
.globl main
main:
        lw    $s0, n_val        # doc n tu bo nho
        move  $a0, $s0
        jal   fib_rec           # doi thanh fib_iter khi do ban lap
        move  $s1, $v0          # luu ket qua F(n)

        li    $v0, 4
        la    $a0, msg1
        syscall

        li    $v0, 1
        move  $a0, $s0
        syscall

        li    $v0, 4
        la    $a0, msg2
        syscall

        li    $v0, 1
        move  $a0, $s1
        syscall

        li    $v0, 10
        syscall

# fib_rec: tinh F(n) bang de quy theo dinh nghia F(n) = F(n-1) + F(n-2)
# Tham so  : $a0 = n (n >= 0)
# Tra ve   : $v0 = F(n)
# Thanh ghi: $ra, $s0 (luu n), $s1 (luu F(n-1)) - cat vao khung 12 byte; $t0
fib_rec:
        addi  $sp, $sp, -12     # prologue: cap khung 3 word
        sw    $ra, 8($sp)
        sw    $s0, 4($sp)
        sw    $s1, 0($sp)

        slti  $t0, $a0, 2       # kiem tra n < 2
        beq   $t0, $zero, fr_rec

fr_base:                        # dat breakpoint o day cho Buoc 3.4
        move  $v0, $a0          # F(0) = 0, F(1) = 1
        j     fr_done

fr_rec:
        move  $s0, $a0          # giu n qua loi goi de quy
        addi  $a0, $s0, -1
        jal   fib_rec           # v0 = F(n - 1)
        move  $s1, $v0          # giu F(n - 1)

        addi  $a0, $s0, -2
        jal   fib_rec           # v0 = F(n - 2)
        addu  $v0, $s1, $v0     # v0 = F(n - 1) + F(n - 2)

fr_done:
        lw    $s1, 0($sp)       # epilogue
        lw    $s0, 4($sp)
        lw    $ra, 8($sp)
        addi  $sp, $sp, 12
        jr    $ra

# fib_iter: tinh F(n) bang vong lap (cap san)
# Tham so  : $a0 = n    Tra ve : $v0 = F(n)
# Thanh ghi: $t0-$t3 (thu tuc la)
fib_iter:
        move  $v0, $zero        # a = F(0)
        li    $t0, 1            # b = F(1)
        move  $t1, $zero        # i = 0
fi_loop:
        slt   $t2, $t1, $a0
        beq   $t2, $zero, fi_done
        addu  $t3, $v0, $t0     # a + b
        move  $v0, $t0
        move  $t0, $t3
        addiu $t1, $t1, 1
        j     fi_loop
fi_done:
        jr    $ra